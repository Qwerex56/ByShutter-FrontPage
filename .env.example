# Skopiuj do .env i uzupelnij. Pliku .env NIE commituj.

# Domena podpieta pod tunel (bez https://)
DOMAIN=byshutter.pl

# Token tunelu: Cloudflare Zero Trust -> Networks -> Tunnels -> Create tunnel (Cloudflared) -> token
CLOUDFLARE_TUNNEL_TOKEN=

# Haslo bazy - wygeneruj np.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Konto admina tworzone przy PIERWSZYM starcie (gdy tabela Users jest pusta).
# Haslo min. 12 znakow. Zmiana tutaj pozniej NIE zmienia hasla w bazie.
ADMIN_USERNAME=piotrek
ADMIN_PASSWORD=

# Id profilu strony glownej (wpisywane do frontendu przy buildzie)
HOME_PROFILE_ID=
